[Unit]
Description=Dispatch monthly Scamper campaigns across all configured cloud providers
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/scamper-controller-monthly run
# The dispatcher waits for each bounded provider campaign in sequence. Each
# provider enforces its configured campaign_timeout_seconds lease.
TimeoutStartSec=infinity
